# Copy this file to .env and fill it in. .env holds credentials - never commit it.
# Everything below is optional and shows its default. Comments must be on their
# own line: text after a value becomes part of the value.

# -- webhooks ----------------------------------------------------------------
# One line per webhook. The part after WEBHOOK_ becomes the name in the dropdown
# (lowercased, underscores become dashes) and the browser only ever sends that
# name. "+ Add" in the page writes them here for you. A bare WEBHOOK_URL is
# offered as "default".
#WEBHOOK_ANNOUNCEMENTS=https://discord.com/api/webhooks/000000000000000000/replace-me

# -- access ------------------------------------------------------------------
# Generated and written here on first run if unset. Rotate by deleting the line.
#AUTH_TOKEN=

# -- server ------------------------------------------------------------------
#PORT=3000

# A public HOST also needs ALLOW_INSECURE=1, your confirmation that TLS is
# terminated in front of this process by a reverse proxy.
#HOST=0.0.0.0
#ALLOW_INSECURE=1

# Trust X-Forwarded-For for rate-limit identity. Only behind a proxy you control.
#TRUST_PROXY=1

# Add and remove webhooks from the page. On by default on localhost, off once
# HOST is public.
#MANAGE_WEBHOOKS=0

# Largest uploaded image, in MB. Discord's own ceiling depends on boost tier.
#UPLOAD_MAX_MB=10

# -- log ---------------------------------------------------------------------
# DWP.log, one JSON object per line, next to this file. Holds message content
# so the Sent panel can be rebuilt from it; never webhook URLs or the token.
#LOG=0
#LOG_FILE=DWP.log
#LOG_MAX_MB=5

# -- schedule ----------------------------------------------------------------
# The queue lives in .schedule/ and is sent by the server, so it fires with no
# browser open. Server only - the packaged exe cannot schedule. GRACE_MIN is how
# late a due message may still be sent before it is marked missed instead.
#SCHEDULE_MAX=200
#SCHEDULE_GRACE_MIN=60

# -- sending -----------------------------------------------------------------
# Strip @everyone / @here / role pings from everything this server sends.
#BLOCK_MENTIONS=1

# -- updates -----------------------------------------------------------------
# UPDATE_CHECK=0 never contacts GitHub. GITHUB_TOKEN is only needed if the repo
# is private. OPEN=0 stops a browser window opening on startup.
#UPDATE_CHECK=0
#UPDATE_REPO=icelogw/Discord-WebHook-Poster
#GITHUB_TOKEN=
#OPEN=0
